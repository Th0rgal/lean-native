{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LeanNativeHardwareCostProfile",
  "version": "lean-native-hardware-profile-v1",
  "type": "object",
  "required": [
    "schema_version",
    "profile_id",
    "target",
    "llvm_target_cpu",
    "add_sub_cost",
    "bitwise_cost",
    "shift_cost",
    "cmp_cost",
    "mul_cost",
    "div_mod_cost",
    "fma_cost",
    "select_cost",
    "clz256_cost",
    "add_sub_checked256_cost",
    "mul_checked256_cost",
    "min_gpu_elements",
    "gpu_block_threads",
    "matmul_tile_dim",
    "calibration_receipt"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "lean-native-hardware-profile-v1" },
    "profile_id": { "type": "string", "minLength": 3 },
    "target": { "type": "string", "enum": ["x86_64", "arm64", "cuda_ptx", "apple_metal", "tpu_xla"] },
    "llvm_target_cpu": { "type": "string" },
    "sm_arch": { "type": "string" },
    "add_sub_cost": { "type": "integer", "minimum": 1, "maximum": 100 },
    "bitwise_cost": { "type": "integer", "minimum": 1, "maximum": 100 },
    "shift_cost": { "type": "integer", "minimum": 1, "maximum": 100 },
    "cmp_cost": { "type": "integer", "minimum": 1, "maximum": 100 },
    "mul_cost": { "type": "integer", "minimum": 1, "maximum": 200 },
    "div_mod_cost": { "type": "integer", "minimum": 2, "maximum": 500 },
    "fma_cost": { "type": "integer", "minimum": 1, "maximum": 200 },
    "select_cost": { "type": "integer", "minimum": 1, "maximum": 100 },
    "clz256_cost": { "type": "integer", "minimum": 1, "maximum": 100 },
    "add_sub_checked256_cost": { "type": "integer", "minimum": 1, "maximum": 100 },
    "mul_checked256_cost": { "type": "integer", "minimum": 1, "maximum": 200 },
    "min_gpu_elements": { "type": "integer", "minimum": 256, "maximum": 16777216 },
    "gpu_block_threads": { "type": "integer", "enum": [64, 128, 256, 512, 1024] },
    "matmul_tile_dim": { "type": "integer", "enum": [8, 16, 32] },
    "hardware_metadata": {
      "type": "object",
      "properties": {
        "host_os": { "type": "string" },
        "host_arch": { "type": "string" },
        "cpu_arch": { "type": "string" },
        "cpu_model": { "type": "string" },
        "gpu_model": { "type": "string" },
        "l1d_bytes": { "type": "integer", "minimum": 16384 },
        "l2_bytes": { "type": "integer", "minimum": 131072 },
        "slc_bytes": { "type": "integer", "minimum": 0 },
        "unified_memory": { "type": "boolean" }
      }
    },
    "cache_trm_tier": {
      "type": "object",
      "required": ["slice_id", "d_model", "d_hidden", "ngram_buckets", "table_d", "max_footprint_bytes", "inference_path"],
      "properties": {
        "slice_id": { "type": "string", "enum": ["stage0_l1", "cpu_l2_int8", "m2_neon_fp16", "spark_gb10_nvfp4"] },
        "d_model": { "type": "integer", "enum": [16, 32, 48, 64] },
        "d_hidden": { "type": "integer", "enum": [32, 64, 96, 128] },
        "ngram_buckets": { "type": "integer", "enum": [4096, 8192, 16384] },
        "table_d": { "type": "integer", "enum": [4, 8, 16] },
        "default_h_cycles": { "type": "integer", "minimum": 1, "maximum": 4 },
        "default_l_cycles": { "type": "integer", "minimum": 1, "maximum": 4 },
        "max_footprint_bytes": { "type": "integer", "minimum": 8192, "maximum": 4194304 },
        "inference_path": { "type": "string", "enum": ["cpu_avx2_int8", "cpu_neon_fp16_accelerate", "gpu_cuda_nvfp4_sm121", "tpu_vmem_bf16"] },
        "batch_gpu_path": { "type": "string" }
      }
    },
    "calibration_receipt": { "type": "object" }
  }
}
