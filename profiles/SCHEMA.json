{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LeanNativeHardwareCostProfile",
  "version": "lean-native-hardware-profile-v1",
  "type": "object",
  "required": [
    "schema_version",
    "profile_id",
    "target",
    "llvm_target_cpu",
    "add_sub_cost",
    "bitwise_cost",
    "shift_cost",
    "cmp_cost",
    "mul_cost",
    "div_mod_cost",
    "fma_cost",
    "select_cost",
    "clz256_cost",
    "add_sub_checked256_cost",
    "mul_checked256_cost",
    "min_gpu_elements",
    "gpu_block_threads",
    "matmul_tile_dim",
    "calibration_receipt"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "lean-native-hardware-profile-v1" },
    "profile_id": { "type": "string", "minLength": 3 },
    "target": { "type": "string", "enum": ["x86_64", "arm64", "cuda_ptx", "apple_metal"] },
    "llvm_target_cpu": { "type": "string" },
    "sm_arch": { "type": "string" },
    "add_sub_cost": { "type": "integer", "minimum": 1, "maximum": 100 },
    "bitwise_cost": { "type": "integer", "minimum": 1, "maximum": 100 },
    "shift_cost": { "type": "integer", "minimum": 1, "maximum": 100 },
    "cmp_cost": { "type": "integer", "minimum": 1, "maximum": 100 },
    "mul_cost": { "type": "integer", "minimum": 1, "maximum": 200 },
    "div_mod_cost": { "type": "integer", "minimum": 2, "maximum": 500 },
    "fma_cost": { "type": "integer", "minimum": 1, "maximum": 200 },
    "select_cost": { "type": "integer", "minimum": 1, "maximum": 100 },
    "clz256_cost": { "type": "integer", "minimum": 1, "maximum": 100 },
    "add_sub_checked256_cost": { "type": "integer", "minimum": 1, "maximum": 100 },
    "mul_checked256_cost": { "type": "integer", "minimum": 1, "maximum": 200 },
    "min_gpu_elements": { "type": "integer", "minimum": 256, "maximum": 16777216 },
    "gpu_block_threads": { "type": "integer", "enum": [64, 128, 256, 512, 1024] },
    "matmul_tile_dim": { "type": "integer", "enum": [8, 16, 32] },
    "calibration_receipt": { "type": "object" }
  }
}
