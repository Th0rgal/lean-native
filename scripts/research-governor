#!/usr/bin/env python3
"""
research-governor — Sidecar CLI, Stream Governor & Self-Healing Telemetry Auditor
backed by `lean-native-core governor`.

All scoring (`computeBayesianScorePermille`), spec-pinning acceptance checks
(`checkBranchAcceptanceGate`), and survival/race-group cutoff transitions (`decideWorkerAction`)
are executed inside the formally verified Lean 4 binary (`lean-native-core governor`, 14 theorems,
0 sorryAx). This script provides the thin I/O bridge to `spark-memory` (:8890), `orb`,
and automatic self-auditing / auto-healing of telemetry and DAG shape invariants.
"""
import argparse
import datetime
import glob
import json
import os
import shutil
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path
from typing import Any, Dict, List, Optional, Tuple


def normalize_effort_tokens(val: Any, default: float = 10000.0) -> float:
    """Always normalize effort_p50 / effort_p90 to tokens. Values in (0, 200) are k-tokens -> * 1000."""
    try:
        f = float(val)
    except (TypeError, ValueError):
        return default
    if f <= 0:
        return default
    if f < 200.0:
        return f * 1000.0
    return f


def find_lean_native_core() -> str:
    env_bin = os.environ.get("LEAN_NATIVE_CORE_BIN")
    if env_bin and os.path.isfile(env_bin) and os.access(env_bin, os.X_OK):
        return env_bin
    script_dir = Path(__file__).resolve().parent
    repo_bin = script_dir.parent / ".lake" / "build" / "bin" / "lean-native-core"
    if repo_bin.is_file() and os.access(repo_bin, os.X_OK):
        return str(repo_bin)
    for candidate in (
        "/usr/local/bin/lean-native-core",
        "/tmp/lean-native-spark/.lake/build/bin/lean-native-core",
        str(Path.home() / ".local" / "bin" / "lean-native-core"),
    ):
        if os.path.isfile(candidate) and os.access(candidate, os.X_OK):
            return candidate
    which_bin = shutil.which("lean-native-core")
    if which_bin:
        return which_bin
    raise FileNotFoundError(
        "Could not locate 'lean-native-core' binary. Set LEAN_NATIVE_CORE_BIN or add it to PATH."
    )


def resolve_ssh_config() -> Optional[str]:
    dev_id = os.environ.get("SANDBOXED_DEVELOPMENT_IDENTITY", "/var/lib/sandboxed-node/Shared/development-identity")
    for candidate in (
        os.path.join(dev_id, "current", "ssh", "config"),
        "/var/lib/sandboxed-node/.config/sandboxed-sh/development-identity/current/ssh/config",
        "/var/lib/sandboxed-node/Shared/development-identity/current/ssh/config",
        "/root/Shared/development-identity/current/ssh/config",
    ):
        if os.path.isfile(candidate):
            return candidate
    return None


def spark_http_via_ssh(method: str, path_and_query: str, token: str, body: Optional[bytes] = None) -> Optional[Dict[str, Any]]:
    ssh_cfg = resolve_ssh_config()
    ssh_base = ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=4"]
    if ssh_cfg:
        ssh_base.extend(["-F", ssh_cfg])
    for host, target_url in (("agent-core", f"http://100.77.4.93:8890{path_and_query}"), ("dgx-spark", f"http://127.0.0.1:8890{path_and_query}")):
        try:
            curl_cmd = f"curl -fsSL -X {method} '{target_url}' -H 'Content-Type: application/json'"
            if token:
                curl_cmd += f" -H 'Authorization: Bearer {token}'"
            if body is not None:
                curl_cmd += " --data-binary @-"
            proc = subprocess.run(
                ssh_base + [host, curl_cmd],
                input=body,
                capture_output=True,
                timeout=6.0,
                check=True,
            )
            return json.loads(proc.stdout.decode("utf-8"))
        except Exception:
            continue
    return None


def resolve_memory_token() -> str:
    tok = os.environ.get("MEMORY_API_TOKEN", "").strip()
    if tok:
        return tok
    for path in ("/etc/spark/memory/token", "/etc/spark/memory/secrets.env"):
        try:
            if os.path.isfile(path) and os.access(path, os.R_OK):
                for line in Path(path).read_text(encoding="utf-8").splitlines():
                    line = line.strip()
                    if not line or line.startswith("#"):
                        continue
                    if line.startswith("MEMORY_API_TOKEN="):
                        return line.split("=", 1)[1].strip().strip('"').strip("'")
                    if "=" not in line:
                        return line
        except Exception:
            pass
    return ""


def call_governor_stream(lines: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
    bin_path = find_lean_native_core()
    payload = "\n".join(json.dumps(item, separators=(",", ":")) for item in lines) + "\n{\"method\":\"exit\"}\n"
    proc = subprocess.run(
        [bin_path, "governor"],
        input=payload,
        text=True,
        capture_output=True,
        check=True,
    )
    out: List[Dict[str, Any]] = []
    for raw_line in proc.stdout.splitlines():
        raw_line = raw_line.strip()
        if raw_line.startswith("{") and raw_line.endswith("}"):
            out.append(json.loads(raw_line))
    return out


def fetch_spark_priors_raw(domain: Optional[str] = None, goal_class: Optional[str] = None) -> Dict[str, Any]:
    base_url = os.environ.get("SPARK_MEMORY_URL", "http://100.77.4.93:8890").rstrip("/")
    token = resolve_memory_token()
    params = {}
    if domain:
        params["domain"] = domain
    if goal_class:
        params["goal_class"] = goal_class
    qs = ("?" + urllib.parse.urlencode(params)) if params else ""
    path_and_query = f"/api/priors{qs}"
    req = urllib.request.Request(f"{base_url}{path_and_query}")
    if token:
        req.add_header("Authorization", f"Bearer {token}")
    try:
        with urllib.request.urlopen(req, timeout=1.5) as resp:
            data = json.loads(resp.read().decode("utf-8"))
    except Exception as exc:
        via_ssh = spark_http_via_ssh("GET", path_and_query, token)
        if via_ssh is not None:
            data = via_ssh
        else:
            return {"items": [], "count": 0, "warning": str(exc)}

    for item in data.get("items") or data.get("priors") or []:
        if "effort_p50" in item:
            item["effort_p50"] = normalize_effort_tokens(item["effort_p50"], 10000.0)
        if "effort_p90" in item:
            item["effort_p90"] = normalize_effort_tokens(item["effort_p90"], 25000.0)
    return data


def fetch_spark_priors(domain: Optional[str] = None, goal_class: Optional[str] = None) -> Dict[str, Dict[str, Any]]:
    data = fetch_spark_priors_raw(domain, goal_class)
    priors_map: Dict[str, Dict[str, Any]] = {}
    items = data.get("items") or data.get("priors") or []
    for p in items:
        dom = p.get("domain", "lean_proof")
        gc = p.get("goal_class") or p.get("branch_type") or "*"
        model = p.get("solver_model", "*")
        for key in (f"{dom}:{gc}:{model}", f"{dom}:{gc}:*", f"{dom}:*:*"):
            if key not in priors_map:
                priors_map[key] = p
    return priors_map


def normalize_outcome(outcome: str) -> str:
    up = outcome.upper().strip()
    if up in ("VALIDATED", "SOLVED", "ACCEPTED", "DONE"):
        return "SOLVED"
    if up in ("FALSIFIED", "FALSE_GOAL", "COUNTEREXAMPLE"):
        return "FALSE_GOAL"
    if up in ("BLOCKED", "REJECTED_GATE"):
        return "BLOCKED"
    return "PRUNED"


def parse_iso_ts(ts: str) -> Optional[float]:
    if not ts:
        return None
    try:
        if ts.endswith("Z"):
            ts = ts[:-1] + "+00:00"
        return datetime.datetime.fromisoformat(ts).timestamp()
    except Exception:
        return None


def extract_metrics_from_transcript(transcript_ref: Optional[str], branch_id: str = "") -> Dict[str, Any]:
    """Extract real tokens, wall_clock_sec, heartbeats, and stage1_rejects from transcript.jsonl and turbo-lean analytics."""
    candidates: List[str] = []
    if transcript_ref:
        if os.path.isfile(transcript_ref):
            candidates.append(transcript_ref)
        else:
            for pattern in (
                f"/var/lib/sandboxed-node/.gemini/antigravity-cli/brain/{transcript_ref}/.system_generated/logs/transcript.jsonl",
                f"/var/lib/sandboxed-node/*/.gemini/antigravity-cli/brain/{transcript_ref}/.system_generated/logs/transcript.jsonl",
                f"{transcript_ref}/.system_generated/logs/transcript.jsonl",
            ):
                candidates.extend(glob.glob(pattern))

    if not candidates:
        all_transcripts = glob.glob("/var/lib/sandboxed-node/.gemini/antigravity-cli/brain/*/.system_generated/logs/transcript.jsonl")
        all_transcripts.extend(glob.glob("/var/lib/sandboxed-node/*/.gemini/antigravity-cli/brain/*/.system_generated/logs/transcript.jsonl"))
        all_transcripts.sort(key=lambda p: os.path.getmtime(p), reverse=True)
        if branch_id:
            for p in all_transcripts[:15]:
                try:
                    txt = Path(p).read_text(encoding="utf-8", errors="ignore")
                    if branch_id in txt:
                        candidates.append(p)
                        break
                except Exception:
                    continue
        if not candidates and all_transcripts:
            candidates.append(all_transcripts[0])

    out: Dict[str, Any] = {}
    if candidates:
        tpath = candidates[0]
        try:
            lines = [json.loads(line) for line in Path(tpath).read_text(encoding="utf-8", errors="ignore").splitlines() if line.strip()]
            if lines:
                chars = sum(
                    len(str(l.get("content", ""))) + len(str(l.get("thinking", ""))) + len(str(l.get("tool_calls", "")))
                    for l in lines
                )
                out["actual_tokens"] = max(500, chars // 4)
                t0 = parse_iso_ts(str(lines[0].get("created_at", "")))
                t1 = parse_iso_ts(str(lines[-1].get("created_at", "")))
                if t0 is not None and t1 is not None and t1 >= t0:
                    out["actual_wall_sec"] = round(t1 - t0, 2)
                out["transcript_path"] = tpath
                parts = Path(tpath).parts
                if "brain" in parts:
                    b_idx = parts.index("brain")
                    if b_idx + 1 < len(parts):
                        out["brain_id"] = parts[b_idx + 1]
        except Exception:
            pass

    total_hb = 0
    total_s1 = 0
    for apath in glob.glob("/dev/shm/turbo-lean-staging-*/mcp_agent_analytics.json"):
        try:
            adata = json.loads(Path(apath).read_text(encoding="utf-8"))
            total_s1 += int(adata.get("stage1_tpu_rejects", 0))
            total_hb += int(adata.get("total_heartbeats", 0))
            if total_hb == 0 and adata.get("stage2_zygote_ms"):
                total_hb += int(float(adata["stage2_zygote_ms"]) * 200.0)
        except Exception:
            continue
    if total_hb > 0:
        out["actual_heartbeats"] = total_hb
    if total_s1 > 0:
        out["stage1_rejects"] = total_s1
    return out


def post_spark_telemetry(event: Dict[str, Any]) -> Dict[str, Any]:
    base_url = os.environ.get("SPARK_MEMORY_URL", "http://100.77.4.93:8890").rstrip("/")
    token = resolve_memory_token()

    auto_healed: List[str] = []
    raw_p50 = event.get("predicted_effort_p50", event.get("effort_p50", 10000.0))
    raw_p90 = event.get("predicted_effort_p90", event.get("effort_p90", 25000.0))
    norm_p50 = normalize_effort_tokens(raw_p50, 10000.0)
    norm_p90 = normalize_effort_tokens(raw_p90, 25000.0)
    if norm_p50 != float(raw_p50 or 0):
        auto_healed.append(f"effort_p50:{raw_p50}->{norm_p50}")
    if norm_p90 != float(raw_p90 or 0):
        auto_healed.append(f"effort_p90:{raw_p90}->{norm_p90}")

    pred_axes = event.get("predicted_axes") or {
        "p": float(event.get("predicted_p", event.get("p", 0.75))),
        "impact": float(event.get("predicted_impact", event.get("impact", 0.85))),
        "effort_p50": norm_p50,
        "effort_p90": norm_p90,
    }
    pred_axes["effort_p50"] = normalize_effort_tokens(pred_axes.get("effort_p50"), 10000.0)
    pred_axes["effort_p90"] = normalize_effort_tokens(pred_axes.get("effort_p90"), 25000.0)

    branch_id = str(event.get("task_key") or event.get("branch_id") or "task-0")
    actual_tokens = int(event.get("actual_tokens", event.get("tokens", 0)))
    actual_hb = int(event.get("actual_heartbeats", event.get("heartbeats", 0)))
    wall_sec = float(event.get("actual_wall_sec", event.get("wall_sec", 0.0)))
    mission_id = str(event.get("mission_id", "mission-local"))

    # Auto-heal fake/default worker telemetry using real transcript & turbo-lean analytics
    suspicious_tokens = actual_tokens <= 0 or (actual_tokens in (12000, 14000, 15000, 16000) and actual_hb == 0)
    if event.get("from_transcript") or suspicious_tokens or mission_id == "mission-local" or wall_sec <= 0:
        extracted = extract_metrics_from_transcript(event.get("from_transcript"), branch_id=branch_id)
        if extracted.get("actual_tokens") and (suspicious_tokens or event.get("from_transcript")):
            auto_healed.append(f"actual_tokens:{actual_tokens}->{extracted['actual_tokens']}")
            actual_tokens = int(extracted["actual_tokens"])
        if extracted.get("actual_wall_sec") and (wall_sec <= 0 or wall_sec in (120.0, 180.0) or event.get("from_transcript")):
            auto_healed.append(f"wall_sec:{wall_sec}->{extracted['actual_wall_sec']}")
            wall_sec = float(extracted["actual_wall_sec"])
        if extracted.get("actual_heartbeats") and actual_hb == 0:
            auto_healed.append(f"heartbeats:0->{extracted['actual_heartbeats']}")
            actual_hb = int(extracted["actual_heartbeats"])
        if mission_id == "mission-local" and extracted.get("brain_id"):
            auto_healed.append(f"mission_id:mission-local->{extracted['brain_id']}")
            mission_id = str(extracted["brain_id"])

    static_feats = event.get("static_features") or {}
    if event.get("failure_mode"):
        static_feats["failure_mode"] = event["failure_mode"]
    if event.get("branch_type"):
        static_feats["branch_type"] = event["branch_type"]
    if auto_healed:
        static_feats["auto_healed"] = auto_healed

    elapsed_ms = event.get("actual_elapsed_ms")
    if elapsed_ms is None or float(elapsed_ms) in (0.0, 120000.0, 180000.0):
        elapsed_ms = wall_sec * 1000.0

    payload = {
        "mission_id": mission_id,
        "task_key": branch_id,
        "parent_task_key": event.get("parent_task_key"),
        "stage": str(event.get("stage", "GRIND")),
        "domain": str(event.get("domain", "lean_proof")),
        "goal_class": str(event.get("goal_class") or event.get("goal_shape_hash") or event.get("branch_type") or "default"),
        "goal_shape_hash": str(event.get("goal_shape_hash") or event.get("goal_class") or "default"),
        "decomposer_model": str(event.get("decomposer_model", "gemini-4-argon")),
        "solver_model": str(event.get("solver_model", "gemini-4-argon")),
        "predicted_axes": pred_axes,
        "static_features": static_feats,
        "checkpoints": event.get("checkpoints") or [],
        "actual_tokens": actual_tokens,
        "actual_heartbeats": actual_hb,
        "actual_elapsed_ms": float(elapsed_ms),
        "outcome": normalize_outcome(str(event.get("outcome", "SOLVED"))),
        "final_metric": event.get("final_metric"),
    }
    body = json.dumps(payload).encode("utf-8")
    req = urllib.request.Request(
        f"{base_url}/api/telemetry",
        data=body,
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    if token:
        req.add_header("Authorization", f"Bearer {token}")
    try:
        with urllib.request.urlopen(req, timeout=1.8) as resp:
            res = json.loads(resp.read().decode("utf-8"))
    except Exception as exc:
        via_ssh = spark_http_via_ssh("POST", "/api/telemetry", token, body)
        if via_ssh is not None:
            res = via_ssh
        else:
            return {"ok": False, "error": str(exc)}
    if auto_healed:
        res["auto_healed_fields"] = auto_healed
    return res


def cmd_priors(args: argparse.Namespace) -> int:
    data = fetch_spark_priors_raw(args.domain, args.branch_type)
    print(json.dumps(data, indent=2))
    return 0


def cmd_record(args: argparse.Namespace) -> int:
    if os.environ.get("RESEARCH_GOVERNOR_ROLE") == "worker" and not args.boss_verified:
        print(
            json.dumps({
                "ok": False,
                "blocked_by": "governor_worker_telemetry_guard",
                "reason": "Workers must NOT self-report telemetry via 'research-governor record'. Only the Boss (with --from-transcript or --boss-verified) records telemetry.",
            }),
            file=sys.stderr,
        )
        return 2

    if args.json:
        event = json.loads(sys.stdin.read() if args.json == "-" else args.json)
    else:
        event = {
            "mission_id": args.mission_id,
            "branch_id": args.branch_id,
            "stage": args.stage,
            "domain": args.domain,
            "branch_type": args.branch_type,
            "goal_class": args.goal_shape,
            "goal_shape_hash": args.goal_shape,
            "solver_model": args.solver_model,
            "decomposer_model": args.decomposer_model,
            "predicted_p": args.p,
            "predicted_impact": args.impact,
            "predicted_effort_p50": args.effort_p50,
            "predicted_effort_p90": args.effort_p90,
            "outcome": args.outcome,
            "actual_tokens": args.tokens,
            "actual_heartbeats": args.heartbeats,
            "actual_wall_sec": args.wall_sec,
            "failure_mode": args.failure_mode,
            "from_transcript": args.from_transcript,
        }
    resp = post_spark_telemetry(event)
    print(json.dumps(resp, indent=2))
    return 0 if resp.get("ok", True) else 1


def cmd_rank(args: argparse.Namespace) -> int:
    if args.input == "-":
        raw = sys.stdin.read()
    elif args.input.strip().startswith("[") or args.input.strip().startswith("{"):
        raw = args.input
    else:
        raw = Path(args.input).read_text(encoding="utf-8")
    candidates = json.loads(raw)
    if isinstance(candidates, dict) and "candidates" in candidates:
        candidates = candidates["candidates"]

    priors = {} if args.no_remote_priors else fetch_spark_priors(args.domain)
    stream_reqs: List[Dict[str, Any]] = []
    meta_by_id: Dict[str, Dict[str, Any]] = {}
    for idx, c in enumerate(candidates):
        dom = c.get("domain", args.domain or "lean_proof")
        btype = str(c.get("branch_type", "PROVE")).upper()
        gclass = c.get("goal_class") or c.get("goal_shape_hash") or btype
        prior = priors.get(f"{dom}:{gclass}:*") or priors.get(f"{dom}:{btype}:*") or priors.get(f"{dom}:*:*") or {}

        prob_permille = c.get("prob_permille")
        if prob_permille is None and "p" in c:
            prob_permille = int(round(float(c["p"]) * 1000))
        if prob_permille is None and "p_mean" in prior:
            prob_permille = int(round(float(prior["p_mean"]) * 1000))

        impact_permille = c.get("impact_permille")
        if impact_permille is None and "impact" in c:
            impact_permille = int(round(float(c["impact"]) * 1000))
        if impact_permille is None and "mean_impact" in prior:
            impact_permille = int(round(float(prior["mean_impact"]) * 1000))
        if impact_permille is None:
            impact_permille = 800

        e50 = int(normalize_effort_tokens(c.get("effort_p50", prior.get("effort_p50", 10000.0)), 10000.0))
        e90 = int(normalize_effort_tokens(c.get("effort_p90", prior.get("effort_p90", 25000.0)), 25000.0))
        bid = str(c.get("branch_id", f"branch-{idx}"))

        req: Dict[str, Any] = {
            "method": "governor-score",
            "branch_id": bid,
            "branch_type": btype,
            "race_group": str(c.get("race_group", "default")),
            "impact_permille": int(impact_permille),
            "effort_p50": e50,
            "effort_p90": e90,
            "risk_aversion_permille": int(c.get("risk_aversion_permille", 350)),
        }
        if prob_permille is not None:
            req["prob_permille"] = int(prob_permille)
        stream_reqs.append(req)
        meta_by_id[bid] = {"effort_p50": e50, "effort_p90": e90, "branch_type": btype}

    scored = call_governor_stream(stream_reqs)
    oversized: List[str] = []
    probe_count = 0
    for item in scored:
        bid = item.get("branch_id", "")
        e50 = int(item.get("effort_p50", meta_by_id.get(bid, {}).get("effort_p50", 10000)))
        btype = str(item.get("branch_type", meta_by_id.get(bid, {}).get("branch_type", "PROVE"))).upper()
        if btype == "PROBE":
            probe_count += 1
        if btype in ("PROVE", "GRIND", "OPTIMIZE") and e50 > 6000:
            item["split_recommended"] = True
            item["split_reason"] = f"effort_p50={e50} > 6000 tokens (violates 1-lemma = 1-file = 1-worker rule)"
            raw_score = int(item.get("bayesian_score_permille", 0))
            penalized = max(1, int(round(raw_score * (6000.0 / float(e50)))))
            item["unpenalized_score_permille"] = raw_score
            item["bayesian_score_permille"] = penalized
            oversized.append(bid)
        else:
            item["split_recommended"] = False

    scored.sort(key=lambda x: x.get("bayesian_score_permille", 0), reverse=True)

    warnings: List[str] = []
    if len(scored) < 6:
        warnings.append(
            f"Narrow DAG (width={len(scored)} < 6): split tasks into 6-8 atomic lemmas (effort_p50 <= 6000) and provision worktrees with 'research-governor warm-pool'."
        )
    if oversized:
        warnings.append(
            f"Oversized GRIND candidates ({', '.join(oversized)} have effort_p50 > 6000): split each into 1 lemma = 1 file = 1 worker."
        )
    if probe_count == 0:
        warnings.append("Missing PROBE branch: include at least 1 fast PROBE task to de-risk the next wave.")

    result = {
        "engine": "lean-native-core/governor",
        "theorems_enforced": [
            "bayesian_falsified_branch_score_zero",
            "bayesian_effective_effort_monotone_in_tail",
            "bayesian_score_monotone_in_prob",
        ],
        "priors_loaded": len(priors),
        "dag_diagnostics": {
            "candidate_count": len(scored),
            "probe_count": probe_count,
            "oversized_candidates": oversized,
            "warnings": warnings,
            "healthy_wide_dag": len(warnings) == 0,
        },
        "ranked_candidates": scored,
    }
    print(json.dumps(result, indent=2))
    return 0


def cmd_watch(args: argparse.Namespace) -> int:
    state_file = Path(args.state_file)
    if not state_file.is_file():
        print(json.dumps({"error": f"State file {state_file} not found"}), file=sys.stderr)
        return 1

    start_ts = time.time()
    while True:
        elapsed = int(time.time() - start_ts)
        raw_state = json.loads(state_file.read_text(encoding="utf-8"))
        workers = raw_state.get("workers", [])
        if not workers:
            print(json.dumps({"status": "idle", "wake_boss": True, "reason": "no_active_workers"}))
            return 0

        winning_groups = set()
        for w in workers:
            if (
                w.get("has_cert")
                and w.get("spec_hash_before", 1) == w.get("spec_hash_after", 1)
                and w.get("forbidden_axioms_count", 0) == 0
                and w.get("vacuous_specs_count", 0) == 0
                and w.get("artifact_certified", True)
            ):
                winning_groups.add(w.get("race_group", "default"))

        reqs: List[Dict[str, Any]] = []
        for w in workers:
            rg = w.get("race_group", "default")
            is_winner_self = bool(w.get("has_cert")) and rg in winning_groups
            sibling_win = (rg in winning_groups) and not is_winner_self
            req = {
                "method": "governor-step",
                "task_id": str(w.get("task_id", "task-0")),
                "race_group": str(rg),
                "tokens_used": int(w.get("tokens_used", 0)),
                "token_budget": int(w.get("token_budget", 50000)),
                "stagnant_checkpoints": int(w.get("stagnant_checkpoints", 0)),
                "max_stagnant_checkpoints": int(w.get("max_stagnant_checkpoints", 3)),
                "stage1_rejects": int(w.get("stage1_rejects", 0)),
                "max_stage1_rejects": int(w.get("max_stage1_rejects", 25)),
                "sibling_winner_found": sibling_win,
                "has_cert": bool(w.get("has_cert", False)),
                "spec_hash_before": int(w.get("spec_hash_before", 1)),
                "spec_hash_after": int(w.get("spec_hash_after", 1)),
                "forbidden_axioms_count": int(w.get("forbidden_axioms_count", 0)),
                "vacuous_specs_count": int(w.get("vacuous_specs_count", 0)),
                "artifact_certified": bool(w.get("artifact_certified", True)),
            }
            reqs.append(req)

        decisions = call_governor_stream(reqs)

        wake_events = [d for d in decisions if d.get("wake_boss")]
        if wake_events or args.once:
            if args.log_telemetry:
                for w, d in zip(workers, decisions):
                    if d.get("wake_boss"):
                        outcome = (
                            "SOLVED"
                            if d.get("acceptance_gate_passed") is True
                            else ("BLOCKED" if d.get("acceptance_gate_passed") is False else "PRUNED")
                        )
                        post_spark_telemetry({
                            "mission_id": args.mission_id,
                            "branch_id": d["task_id"],
                            "domain": w.get("domain", "lean_proof"),
                            "branch_type": w.get("branch_type", "PROVE"),
                            "goal_class": w.get("goal_class", w.get("goal_shape_hash", "default")),
                            "goal_shape_hash": w.get("goal_shape_hash", "default"),
                            "predicted_p": float(w.get("prob_permille", 500)) / 1000.0,
                            "predicted_impact": float(w.get("impact_permille", 800)) / 1000.0,
                            "predicted_effort_p50": normalize_effort_tokens(w.get("effort_p50", 10000.0), 10000.0),
                            "predicted_effort_p90": normalize_effort_tokens(w.get("effort_p90", 25000.0), 25000.0),
                            "outcome": outcome,
                            "actual_tokens": d["tokens_used"],
                            "actual_wall_sec": float(elapsed),
                            "from_transcript": w.get("transcript_path"),
                            "failure_mode": None if outcome == "SOLVED" else d.get("wake_reason"),
                        })
            print(json.dumps({
                "status": "wake_boss" if wake_events else "snapshot",
                "mission_id": args.mission_id,
                "elapsed_sec": elapsed,
                "decisions": decisions,
                "wake_events": wake_events,
            }, indent=2))
            return 0

        time.sleep(args.interval)


def cmd_warm_lake(args: argparse.Namespace) -> int:
    """Sync precompiled .lake & .hol artifacts across fleet nodes (or via <0.5s local cp -alT hardlinks)."""
    src = args.source.rstrip("/")
    dst = args.dest.rstrip("/")
    os.makedirs(dst, exist_ok=True)

    local_src = src.split(":", 1)[1] if ":" in src and os.path.isdir(src.split(":", 1)[1] + "/.lake") else (src if ":" not in src else None)
    if not local_src:
        for cand in (
            "/var/lib/sandboxed-node/c83baa5b-26aa-4851-b014-75db14894496/evm.fast-dev",
            "/var/lib/sandboxed-node/3fe5c5a3-f3b9-482d-b3f5-3afc779c2be8/evm.fast-dev",
        ):
            if os.path.isdir(cand + "/.lake") and os.path.abspath(cand) != os.path.abspath(dst):
                local_src = cand
                break

    if local_src and os.path.isdir(local_src + "/.lake"):
        for sub in (".lake", ".hol"):
            s_path = os.path.join(local_src, sub)
            d_path = os.path.join(dst, sub)
            if os.path.isdir(s_path):
                subprocess.run(["cp", "-alT", s_path, d_path], check=False)
        print(json.dumps({"ok": True, "mode": "local_hardlink_cp_alT", "source": local_src, "dest": dst}))
        return 0

    ssh_cfg = resolve_ssh_config()
    ssh_cmd = f"ssh -F {ssh_cfg}" if ssh_cfg else "ssh"
    rsync_cmd = [
        "rsync",
        "-az",
        "-e",
        ssh_cmd,
        f"{src}/.lake",
        f"{src}/.hol",
        f"{dst}/",
    ]
    proc = subprocess.run(rsync_cmd)
    if proc.returncode != 0:
        return proc.returncode
    print(json.dumps({"ok": True, "mode": "remote_rsync", "source": src, "dest": dst}))
    return 0


def cmd_warm_pool(args: argparse.Namespace) -> int:
    """Provision N isolated, pre-warmed worktrees in <2s via git worktree + cp -alT hardlinks of .lake & .hol."""
    src = os.path.abspath(args.source.rstrip("/"))
    base = os.path.abspath(args.dest_base.rstrip("/"))
    count = max(1, int(args.count))
    os.makedirs(base, exist_ok=True)
    t0 = time.time()
    created: List[str] = []

    subprocess.run(["git", "-C", src, "worktree", "prune"], check=False, capture_output=True)
    for i in range(1, count + 1):
        wt = os.path.join(base, f"{args.prefix}-{i}")
        if not os.path.isdir(os.path.join(wt, ".git")) and not os.path.isfile(os.path.join(wt, ".git")):
            if os.path.exists(wt):
                shutil.rmtree(wt, ignore_errors=True)
            res = subprocess.run(
                ["git", "-C", src, "worktree", "add", "--detach", "--force", wt, "HEAD"],
                capture_output=True,
                text=True,
            )
            if res.returncode != 0:
                os.makedirs(wt, exist_ok=True)
                subprocess.run(["cp", "-alT", src, wt], check=False)
        for sub in (".lake", ".hol"):
            s_sub = os.path.join(src, sub)
            d_sub = os.path.join(wt, sub)
            if os.path.isdir(s_sub):
                subprocess.run(["cp", "-alT", s_sub, d_sub], check=False)
        created.append(wt)

    elapsed_ms = round((time.time() - t0) * 1000.0, 1)
    print(json.dumps({
        "ok": True,
        "count": len(created),
        "elapsed_ms": elapsed_ms,
        "source": src,
        "worktrees": created,
    }, indent=2))
    return 0


def cmd_audit_campaign(args: argparse.Namespace) -> int:
    """Detect and optionally auto-fix telemetry unit skew, fake worker reports, narrow DAGs, and duplicate declarations."""
    ssh_cfg = resolve_ssh_config()
    ssh_base = ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=5"]
    if ssh_cfg:
        ssh_base.extend(["-F", ssh_cfg])

    issues: List[Dict[str, Any]] = []
    healed: List[str] = []

    sql_check = (
        "SELECT id, mission_id, task_key, goal_class, "
        "(predicted_axes->>'effort_p50')::float AS p50, "
        "(predicted_axes->>'effort_p90')::float AS p90, "
        "actual_tokens, actual_heartbeats, actual_elapsed_ms, outcome "
        "FROM research_telemetry ORDER BY created_at ASC;"
    )
    try:
        proc = subprocess.run(
            ssh_base + [
                "dgx-spark",
                f"docker exec hindsight-db psql -U hindsight_user -d hindsight_db -t -A -F '|' -c \"{sql_check}\"",
            ],
            capture_output=True,
            text=True,
            timeout=8.0,
        )
        if proc.returncode == 0:
            for line in proc.stdout.splitlines():
                parts = line.strip().split("|")
                if len(parts) < 10:
                    continue
                row_id, mid, tkey, gclass, p50_s, p90_s, tok_s, hb_s, el_s, outc = parts[:10]
                p50 = float(p50_s or 0)
                p90 = float(p90_s or 0)
                tok = int(tok_s or 0)
                hb = int(hb_s or 0)
                if 0 < p50 < 200 or 0 < p90 < 200:
                    issues.append({"type": "unit_skew_k_tokens", "id": row_id, "task_key": tkey, "p50": p50, "p90": p90})
                if mid == "mission-local":
                    issues.append({"type": "unattributed_mission_local", "id": row_id, "task_key": tkey})
                if outc == "SOLVED" and (tok <= 0 or hb <= 0):
                    issues.append({"type": "missing_real_counters", "id": row_id, "task_key": tkey, "tokens": tok, "heartbeats": hb})

            if args.fix and issues:
                fix_sql = """
                UPDATE research_telemetry
                SET predicted_axes = jsonb_set(
                  jsonb_set(
                    predicted_axes,
                    '{effort_p50}',
                    to_jsonb(CASE WHEN (predicted_axes->>'effort_p50')::float < 200 THEN (predicted_axes->>'effort_p50')::float * 1000.0 ELSE (predicted_axes->>'effort_p50')::float END)
                  ),
                  '{effort_p90}',
                  to_jsonb(CASE WHEN (predicted_axes->>'effort_p90')::float < 200 THEN (predicted_axes->>'effort_p90')::float * 1000.0 ELSE (predicted_axes->>'effort_p90')::float END)
                )
                WHERE (predicted_axes->>'effort_p50')::float < 200 OR (predicted_axes->>'effort_p90')::float < 200;

                WITH agg AS (
                  SELECT
                    domain, goal_class, solver_model,
                    COUNT(*) AS sample_count,
                    1.0 + SUM(CASE WHEN outcome IN ('SOLVED', 'VALIDATED', 'FALSIFIED') THEN 1.0 ELSE 0.0 END) AS alpha,
                    1.0 + SUM(CASE WHEN outcome NOT IN ('SOLVED', 'VALIDATED', 'FALSIFIED') THEN 1.0 ELSE 0.0 END) AS beta,
                    PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY GREATEST(actual_tokens::float, (predicted_axes->>'effort_p50')::float)) AS effort_p50,
                    PERCENTILE_CONT(0.9) WITHIN GROUP (ORDER BY GREATEST(actual_tokens::float, (predicted_axes->>'effort_p90')::float)) AS effort_p90,
                    AVG((predicted_axes->>'impact')::float) AS mean_impact
                  FROM research_telemetry
                  GROUP BY domain, goal_class, solver_model
                )
                UPDATE research_priors_summary p
                SET alpha = agg.alpha, beta = agg.beta,
                    effort_p50 = ROUND(agg.effort_p50::numeric, 1),
                    effort_p90 = ROUND(agg.effort_p90::numeric, 1),
                    early_stop_tokens = ROUND(agg.effort_p90::numeric, 1),
                    mean_impact = ROUND(agg.mean_impact::numeric, 3),
                    sample_count = agg.sample_count, updated_at = now()
                FROM agg
                WHERE p.domain = agg.domain AND p.goal_class = agg.goal_class AND p.solver_model = agg.solver_model;
                """
                subprocess.run(
                    ssh_base + ["dgx-spark", "docker exec -i hindsight-db psql -U hindsight_user -d hindsight_db"],
                    input=fix_sql,
                    text=True,
                    capture_output=True,
                    timeout=8.0,
                )
                healed.append("recomputed_priors_and_normalized_units")
    except Exception as exc:
        issues.append({"type": "db_unreachable", "detail": str(exc)})

    print(json.dumps({
        "ok": len(issues) == 0 or len(healed) > 0,
        "issues_found": len(issues),
        "issues": issues,
        "healed": healed,
    }, indent=2))
    return 0


def main() -> int:
    if len(sys.argv) > 1 and sys.argv[1] in ("step", "score", "self-test", "stream"):
        if "--help" in sys.argv or "-h" in sys.argv:
            subcmd = sys.argv[1]
            if subcmd == "step":
                print(
                    "usage: research-governor step --task-id ID --race-group GROUP "
                    "[--tokens-used N] [--token-budget N] [--stagnant N] [--max-stagnant N] "
                    "[--stage1-rejects N] [--max-stage1-rejects N] [--sibling-winner] "
                    "[--verify-cert --spec-before H1 --spec-after H2 --forbidden-axioms N --vacuous-specs N]"
                )
            elif subcmd == "score":
                print(
                    "usage: research-governor score --branch-id ID [--branch-type PROVE|REFUTE|PROBE|OPTIMIZE] "
                    "[--race-group GROUP] --prob-permille P --impact-permille I --effort-p50 E50 --effort-p90 E90"
                )
            else:
                print(f"usage: research-governor {subcmd}")
            return 0
        bin_path = find_lean_native_core()
        sub = sys.argv[1:] if sys.argv[1] != "stream" else []
        proc = subprocess.run([bin_path, "governor", *sub])
        return proc.returncode

    parser = argparse.ArgumentParser(description="Formally Verified Bayesian Research Governor (LeanNative)")
    subparsers = parser.add_subparsers(dest="cmd", required=True)

    p_priors = subparsers.add_parser("priors", help="Fetch empirical Bayesian priors from spark-memory (:8890)")
    p_priors.add_argument("--domain", default=None, help="Filter by domain (e.g. lean_proof, formal_spec, gpu_kernel)")
    p_priors.add_argument("--branch-type", default=None, help="Filter by goal_class / branch_type")

    p_rank = subparsers.add_parser("rank", help="Rank candidate research branches using 64-bit Lean 4 Bayesian kernel")
    p_rank.add_argument("input", help="Path to JSON candidate list, inline JSON array, or '-' for stdin")
    p_rank.add_argument("--domain", default=None, help="Default domain for spark-memory priors lookup")
    p_rank.add_argument("--no-remote-priors", action="store_true", help="Skip querying spark-memory for empirical priors")

    p_record = subparsers.add_parser("record", help="[Boss Only] Record a research branch outcome & telemetry to spark-memory (:8890)")
    p_record.add_argument("--json", default=None, help="Inline JSON object or '-' for stdin")
    p_record.add_argument("--mission-id", default="mission-local", help="Orb mission ID")
    p_record.add_argument("--branch-id", default="branch-0", help="Branch or task ID")
    p_record.add_argument("--stage", default="GRIND", help="Stage (ABSTRACT, CONTRACT, GRIND)")
    p_record.add_argument("--domain", default="lean_proof", help="Domain (lean_proof, formal_spec, gpu_kernel)")
    p_record.add_argument("--branch-type", default="PROVE", help="Branch type (PROVE, REFUTE, PROBE, OPTIMIZE)")
    p_record.add_argument("--goal-shape", default="clocked_sim_bridge", help="Goal class / shape family tag")
    p_record.add_argument("--solver-model", default="gemini-4-argon", help="Model used by worker/solver")
    p_record.add_argument("--decomposer-model", default="gemini-4-argon", help="Model used by Boss decomposer")
    p_record.add_argument("--p", type=float, default=0.75, help="Predicted probability p (0..1)")
    p_record.add_argument("--impact", type=float, default=0.85, help="Predicted impact I (0..1)")
    p_record.add_argument("--effort-p50", type=float, default=10000.0, help="Predicted median effort in tokens")
    p_record.add_argument("--effort-p90", type=float, default=25000.0, help="Predicted p90 effort in tokens")
    p_record.add_argument("--outcome", default="VALIDATED", help="Outcome (VALIDATED/SOLVED, FALSIFIED/FALSE_GOAL, PRUNED, BLOCKED)")
    p_record.add_argument("--tokens", type=int, default=0, help="Actual tokens consumed (auto-extracted if --from-transcript)")
    p_record.add_argument("--heartbeats", type=int, default=0, help="Actual Lean heartbeats (auto-extracted from turbo-lean analytics)")
    p_record.add_argument("--wall-sec", type=float, default=0.0, help="Actual wall-clock seconds (auto-extracted if --from-transcript)")
    p_record.add_argument("--from-transcript", default=None, help="Path or brain UUID of worker transcript.jsonl for exact counter extraction")
    p_record.add_argument("--boss-verified", action="store_true", help="Certify that Boss is recording verified telemetry")
    p_record.add_argument("--failure-mode", default=None, help="Optional failure mode / counterexample summary")

    p_watch = subparsers.add_parser("watch", help="Watch active workers, enforce race_group/budget/survival cutoffs, and wake Boss")
    p_watch.add_argument("--mission-id", default="mission-local", help="Orb mission ID")
    p_watch.add_argument("--state-file", required=True, help="Path to live worker telemetry state JSON")
    p_watch.add_argument("--interval", type=float, default=2.0, help="Watch interval in seconds")
    p_watch.add_argument("--once", action="store_true", help="Evaluate once and exit immediately")
    p_watch.add_argument("--log-telemetry", action="store_true", help="Automatically record checkpoints/outcomes to spark-memory")

    p_warm = subparsers.add_parser("warm-lake", help="Sync prebuilt .lake and .hol caches from a fleet host without invalidating Lake package .git or .ir files")
    p_warm.add_argument("source", help="Source host:project_dir (e.g. ashur:/path/to/evm.fast-dev)")
    p_warm.add_argument("dest", help="Destination project_dir")

    p_pool = subparsers.add_parser("warm-pool", help="Provision N isolated, pre-warmed worktrees in <2s via git worktree + cp -alT hardlinks")
    p_pool.add_argument("source", help="Source warm repository directory")
    p_pool.add_argument("dest_base", help="Base directory for wt-1..wt-N")
    p_pool.add_argument("--count", type=int, default=6, help="Number of parallel worktrees to provision (default: 6)")
    p_pool.add_argument("--prefix", default="wt", help="Worktree directory prefix (default: wt)")

    p_audit = subparsers.add_parser("audit-campaign", help="Audit telemetry units, real counters, and DAG invariants; auto-heal with --fix")
    p_audit.add_argument("--fix", action="store_true", help="Automatically heal unit skews and recompute research_priors_summary")

    args = parser.parse_args()
    if args.cmd == "priors":
        return cmd_priors(args)
    if args.cmd == "record":
        return cmd_record(args)
    if args.cmd == "rank":
        return cmd_rank(args)
    if args.cmd == "watch":
        return cmd_watch(args)
    if args.cmd == "warm-lake":
        return cmd_warm_lake(args)
    if args.cmd == "warm-pool":
        return cmd_warm_pool(args)
    if args.cmd == "audit-campaign":
        return cmd_audit_campaign(args)
    return 1


if __name__ == "__main__":
    sys.exit(main())
